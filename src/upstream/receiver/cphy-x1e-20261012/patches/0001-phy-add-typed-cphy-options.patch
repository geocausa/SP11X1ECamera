diff --git a/include/linux/phy/phy-mipi-cphy.h b/include/linux/phy/phy-mipi-cphy.h
new file mode 100644
--- /dev/null
+++ b/include/linux/phy/phy-mipi-cphy.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __PHY_MIPI_CPHY_H_
+#define __PHY_MIPI_CPHY_H_
+
+#include <linux/types.h>
+
+/**
+ * struct phy_configure_opts_mipi_cphy - MIPI C-PHY configuration
+ * @symbol_rate: Symbol rate in symbols per second, not V4L2 link frequency.
+ * @num_trios: Number of active three-wire trios. There is no clock lane.
+ *
+ * Physical routing and wire order come from the PHY's firmware endpoint.
+ * Providers must reject configurations they cannot support.
+ */
+struct phy_configure_opts_mipi_cphy {
+	u64 symbol_rate;
+	unsigned int num_trios;
+};
+
+#endif /* __PHY_MIPI_CPHY_H_ */
