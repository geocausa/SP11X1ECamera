+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+
+#include "phy-qcom-mipi-csi2.h"
+#include "phy-qcom-mipi-csi2-cphy-x1e80100.h"
+
+int mipi_csi2phy_cphy_validate(struct mipi_csi2phy_device *csi2phy,
+			     const struct mipi_csi2phy_stream_cfg *cfg)
+{
+	if (!csi2phy || !cfg)
+		return -EINVAL;
+
+	if (!csi2phy->cphy_supported ||
+	    csi2phy->phy_mode != PHY_MODE_MIPI_CPHY ||
+	    csi2phy->soc_cfg != &mipi_csi2_dphy_4nm_x1e)
+		return -EOPNOTSUPP;
+
+	if (cfg->num_data_lanes != 1 || cfg->lane_cfg.data[0].pos ||
+	    cfg->lane_cfg.data[0].pol || cfg->lane_cfg.clk.pol)
+		return -EOPNOTSUPP;
+
+	if (cfg->symbol_rate != csi2phy->soc_cfg->cphy_symbol_rate)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static void
+mipi_csi2phy_cphy_write(struct mipi_csi2phy_device *csi2phy,
+		       const struct x1e80100_cphy_reg *table,
+		       unsigned int count)
+{
+	unsigned int i;
+
+	might_sleep();
+
+	for (i = 0; i < count; i++) {
+		u32 delay_us;
+
+		writel(table[i].reg_data, csi2phy->base + table[i].reg_addr);
+		if (!table[i].delay_ns)
+			continue;
+
+		delay_us = max_t(u32, table[i].delay_ns / NSEC_PER_USEC, 1);
+		if (delay_us <= 10)
+			udelay(delay_us);
+		else
+			usleep_range(delay_us,
+				     delay_us + max(delay_us / 100, 10U));
+	}
+}
+
+irqreturn_t mipi_csi2phy_cphy_irq(int irq, void *data)
+{
+	struct mipi_csi2phy_device *csi2phy = data;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(x1e80100_cphy_irq_clear); i++) {
+		u32 delay_us;
+
+		writel(x1e80100_cphy_irq_clear[i].reg_data,
+		       csi2phy->base + x1e80100_cphy_irq_clear[i].reg_addr);
+		if (!x1e80100_cphy_irq_clear[i].delay_ns)
+			continue;
+
+		delay_us = max_t(u32, x1e80100_cphy_irq_clear[i].delay_ns /
+				 NSEC_PER_USEC, 1);
+		udelay(delay_us);
+	}
+
+	return IRQ_HANDLED;
+}
+
+int mipi_csi2phy_cphy_enable(struct mipi_csi2phy_device *csi2phy,
+			   struct mipi_csi2phy_stream_cfg *cfg)
+{
+	int ret;
+
+	ret = mipi_csi2phy_cphy_validate(csi2phy, cfg);
+	if (ret)
+		return ret;
+
+	mipi_csi2phy_cphy_write(csi2phy, x1e80100_cphy_reset,
+			       ARRAY_SIZE(x1e80100_cphy_reset));
+	mipi_csi2phy_cphy_write(csi2phy, x1e80100_cphy_toggle,
+			       ARRAY_SIZE(x1e80100_cphy_toggle));
+	mipi_csi2phy_cphy_write(csi2phy, x1e80100_cphy_common,
+			       ARRAY_SIZE(x1e80100_cphy_common));
+	mipi_csi2phy_cphy_write(csi2phy, x1e80100_cphy_config,
+			       ARRAY_SIZE(x1e80100_cphy_config));
+	/* Clear stale status before the core enables the owned Linux IRQ. */
+	mipi_csi2phy_cphy_irq(csi2phy->irq, csi2phy);
+
+	return 0;
+}
+
+void mipi_csi2phy_cphy_disable(struct mipi_csi2phy_device *csi2phy)
+{
+	unsigned int i;
+
+	/* The core has synchronously drained the Linux handler, with clocks on. */
+	for (i = 11; i < 22; i++)
+		writel(0, csi2phy->base + 0x1000 + 4 * i);
+
+	mipi_csi2phy_cphy_irq(csi2phy->irq, csi2phy);
+	mipi_csi2phy_cphy_write(csi2phy, x1e80100_cphy_shutdown,
+			       ARRAY_SIZE(x1e80100_cphy_shutdown));
+}
