 /*
+ * vfe_put_output_v2 - Release a line's completion-port mapping
+ *
+ * Gen2+ completions are routed by line/CSID port, independently of the bus
+ * clients which write the output. Gen1 keeps its write-master reservation
+ * path in vfe_put_output().
+ */
+static void vfe_put_output_v2(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+
+	vfe->wm_output_map[line->id] = VFE_LINE_NONE;
+	for (i = 0; i < line->num_outputs; i++)
+		line->output[i].state = VFE_OUTPUT_OFF;
+
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+}
+
+/*
  * vfe_enable_v2 - Enable streaming on VFE line
  * @line: VFE line
  *
@@ -1056,7 +1078,7 @@
 	return 0;
 
 error_enable_output:
-	vfe_put_output(line);
+	vfe_put_output_v2(line);
 
 error_get_output:
 	mutex_lock(&vfe->stream_lock);
@@ -1261,7 +1283,7 @@
  *
  * Return 0 on success or a negative error code otherwise
  */
-int vfe_disable(struct vfe_line *line)
+static int vfe_disable_common(struct vfe_line *line, bool port_mapping)
 {
 	struct vfe_device *vfe = to_vfe(line);
 	int ret;
@@ -1270,7 +1292,10 @@
 	if (ret)
 		goto error;
 
-	vfe_put_output(line);
+	if (port_mapping)
+		vfe_put_output_v2(line);
+	else
+		vfe_put_output(line);
 
 	mutex_lock(&vfe->stream_lock);
 
@@ -1280,6 +1305,16 @@
 
 error:
 	return ret;
+}
+
+int vfe_disable(struct vfe_line *line)
+{
+	return vfe_disable_common(line, false);
+}
+
+int vfe_disable_v2(struct vfe_line *line)
+{
+	return vfe_disable_common(line, true);
 }
 
