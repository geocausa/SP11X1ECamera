diff --git a/drivers/media/platform/qcom/camss/camss-csid-680.c b/drivers/media/platform/qcom/camss/camss-csid-680.c
--- a/drivers/media/platform/qcom/camss/camss-csid-680.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-680.c
@@ -86,6 +86,10 @@
 #define CSID_CSI2_RX_IRQ_MASK					0xa0
 #define CSID_CSI2_RX_IRQ_CLEAR					0xa4
 
+#define CSID_IPP_IRQ_STATUS					0xac
+#define CSID_IPP_IRQ_MASK					0xb0
+#define CSID_IPP_IRQ_CLEAR					0xb4
+
 #define CSID_RESET_CFG						0xc
 #define		CSID_RESET_CFG_MODE_IMMEDIATE			BIT(0)
 #define		CSID_RESET_CFG_LOCATION_COMPLETE		BIT(4)
@@ -321,6 +325,155 @@
  *
  * Return 0 on success or a negative error code otherwise
  */
+static void csid_mask_stream_irqs(struct csid_device *csid, u32 top)
+{
+	int i;
+
+	writel(top, csid->base + CSID_TOP_IRQ_MASK);
+	writel(0, csid->base + CSID_BUF_DONE_IRQ_MASK);
+	writel(0, csid->base + CSID_CSI2_RX_IRQ_MASK);
+	writel(0, csid->base + CSID_IPP_IRQ_MASK);
+	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++)
+		writel(0, csid->base + CSID_CSI2_RDIN_IRQ_MASK(i));
+	readl(csid->base + CSID_TOP_IRQ_MASK);
+}
+
+static void csid_clear_stream_status(struct csid_device *csid)
+{
+	u32 val;
+	int i;
+
+	val = readl(csid->base + CSID_TOP_IRQ_STATUS);
+	writel(val, csid->base + CSID_TOP_IRQ_CLEAR);
+	val = readl(csid->base + CSID_BUF_DONE_IRQ_STATUS);
+	writel(val, csid->base + CSID_BUF_DONE_IRQ_CLEAR);
+	val = readl(csid->base + CSID_CSI2_RX_IRQ_STATUS);
+	writel(val, csid->base + CSID_CSI2_RX_IRQ_CLEAR);
+	val = readl(csid->base + CSID_IPP_IRQ_STATUS);
+	writel(val, csid->base + CSID_IPP_IRQ_CLEAR);
+	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++) {
+		val = readl(csid->base + CSID_CSI2_RDIN_IRQ_STATUS(i));
+		writel(val, csid->base + CSID_CSI2_RDIN_IRQ_CLEAR(i));
+	}
+	writel(CSID_IRQ_CMD_CLEAR, csid->base + CSID_IRQ_CMD);
+}
+
+static bool csid_stream_irqs_quiet(struct csid_device *csid)
+{
+	int i;
+
+	if (readl(csid->base + CSID_TOP_IRQ_MASK) ||
+	    readl(csid->base + CSID_BUF_DONE_IRQ_MASK) ||
+	    readl(csid->base + CSID_CSI2_RX_IRQ_MASK) ||
+	    readl(csid->base + CSID_IPP_IRQ_MASK) ||
+	    readl(csid->base + CSID_TOP_IRQ_STATUS) ||
+	    readl(csid->base + CSID_BUF_DONE_IRQ_STATUS) ||
+	    readl(csid->base + CSID_CSI2_RX_IRQ_STATUS) ||
+	    readl(csid->base + CSID_IPP_IRQ_STATUS))
+		return false;
+	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++)
+		if (readl(csid->base + CSID_CSI2_RDIN_IRQ_MASK(i)) ||
+		    readl(csid->base + CSID_CSI2_RDIN_IRQ_STATUS(i)))
+			return false;
+	return true;
+}
+
+static int csid_quiesce_stream(struct csid_device *csid)
+{
+	unsigned long time;
+
+	/* Reuse the native reset/drain contract with a fresh ACK boundary. */
+	csid_mask_stream_irqs(csid, 0);
+	synchronize_irq(csid->irq);
+	csid_clear_stream_status(csid);
+	if (readl(csid->base + CSID_TOP_IRQ_STATUS) & CSID_TOP_IRQ_RESET)
+		return -EIO;
+
+	reinit_completion(&csid->reset_complete);
+	csid_mask_stream_irqs(csid, CSID_TOP_IRQ_RESET);
+	writel(0, csid->base + CSID_CSI2_RX_CFG0);
+	writel(0, csid->base + CSID_CSI2_RX_CFG1);
+	writel(CSID_RESET_CFG_MODE_IMMEDIATE | CSID_RESET_CFG_LOCATION_COMPLETE,
+	       csid->base + CSID_RESET_CFG);
+	writel(CSID_RESET_CMD_HW_RESET, csid->base + CSID_RESET_CMD);
+	time = wait_for_completion_timeout(&csid->reset_complete,
+					  msecs_to_jiffies(CSID_RESET_TIMEOUT_MS));
+
+	/* Even a timeout drains Linux callbacks but retains all DMA/PM ownership. */
+	csid_mask_stream_irqs(csid, 0);
+	synchronize_irq(csid->irq);
+	csid_clear_stream_status(csid);
+	synchronize_irq(csid->irq);
+	if (!time)
+		return -ETIMEDOUT;
+	if (!csid_stream_irqs_quiet(csid) ||
+	    readl(csid->base + CSID_CSI2_RX_CFG0) ||
+	    readl(csid->base + CSID_CSI2_RX_CFG1))
+		return -EBUSY;
+
+	csid->reg_update = 0;
+	return 0;
+}
+
+static void csid_enable_stream_irqs(struct csid_device *csid)
+{
+	int i;
+
+	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++)
+		writel(CSID_CSI2_RDIN_RUP_DONE, csid->base + CSID_CSI2_RDIN_IRQ_MASK(i));
+	writel(~0u, csid->base + CSID_BUF_DONE_IRQ_CLEAR);
+	writel(~0u, csid->base + CSID_BUF_DONE_IRQ_MASK);
+	writel(~0u, csid->base + CSID_TOP_IRQ_MASK);
+}
+
+static int csid_configure_stream_checked(struct csid_device *csid, u8 enable)
+{
+	struct camss_video *owner = READ_ONCE(csid->camss->stream_owner);
+	int ret = 0;
+
+	mutex_lock(&csid->stream_lock);
+	if (csid->stream_fault) {
+		ret = -EUCLEAN;
+		goto out;
+	}
+	if (!owner || !csid->irq ||
+	    csid->camss->res->version != CAMSS_X1E80100 ||
+	    !csid->phy.en_vc ||
+	    (csid->phy.en_vc & ~GENMASK(MSM_CSID_MAX_SRC_STREAMS - 1, 0)) ||
+	    hweight32(csid->phy.en_vc) != 1) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (enable) {
+		if (csid->stream_owned) {
+			ret = -EBUSY;
+			goto out;
+		}
+		csid->stream_owner = owner;
+		csid->stream_quiesced = false;
+		/* Reopen need not cause a pipeline power cycle. */
+		csid_enable_stream_irqs(csid);
+		csid_configure_stream(csid, 1);
+		csid->stream_owned = true;
+	} else {
+		if (csid->stream_owner != owner || !csid->stream_owned) {
+			ret = -EINVAL;
+			goto out;
+		}
+		ret = csid_quiesce_stream(csid);
+		if (ret) {
+			csid->stream_fault = true;
+			dev_err(csid->camss->dev, "CSID quiesce failed: %d\n", ret);
+			goto out;
+		}
+		csid->stream_owned = false;
+		csid->stream_quiesced = true;
+	}
+out:
+	mutex_unlock(&csid->stream_lock);
+	return ret;
+}
+
 static int csid_reset(struct csid_device *csid)
 {
 	unsigned long time;
@@ -446,6 +599,7 @@
 const struct csid_hw_ops csid_ops_680 = {
 	.configure_testgen_pattern = NULL,
 	.configure_stream = csid_configure_stream,
+	.configure_stream_checked = csid_configure_stream_checked,
 	.hw_version = csid_hw_version,
 	.isr = csid_isr,
 	.reset = csid_reset,
