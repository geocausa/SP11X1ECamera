@@ -1268,12 +1291,44 @@
 	return 0;
 }
 
+int vfe_prepare_stop(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_output *output = &line->output[0];
+	unsigned long flags;
+	unsigned long time;
+
+	if (!vfe->res->hw_ops->vfe_output_quiesce)
+		return 0;
+	if (line->is_pix || line->num_outputs != 1 ||
+	    READ_ONCE(vfe->camss->stream_owner) != &output->video_out)
+		return -EINVAL;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	reinit_completion(&output->drain_complete);
+	output->state = VFE_OUTPUT_STOPPING;
+	if (!output->gen2.active_num)
+		complete(&output->drain_complete);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+
+	time = wait_for_completion_timeout(&output->drain_complete,
+					  msecs_to_jiffies(CSID_RESET_TIMEOUT_MS));
+	if (!time)
+		return -ETIMEDOUT;
+	if (READ_ONCE(output->video_out.lifecycle.fault))
+		return -EUCLEAN;
+	return 0;
+}
+
 static int vfe_disable_output(struct vfe_line *line)
 {
 	struct vfe_device *vfe = to_vfe(line);
 	const struct vfe_hw_ops *ops = vfe->res->hw_ops;
 	unsigned long flags;
 	unsigned int i, o;
+
+	if (ops->vfe_output_quiesce)
+		return ops->vfe_output_quiesce(line);
 
 	spin_lock_irqsave(&vfe->output_lock, flags);
 	for (o = 0; o < line->num_outputs; o++) {
@@ -2481,6 +2536,7 @@
 			l->output[o].video_out.camss = camss;
 			init_completion(&l->output[o].sof);
 			init_completion(&l->output[o].reg_update);
+			init_completion(&l->output[o].drain_complete);
 		}
 
 		l->output[0].video_out.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-680.c b/drivers/media/platform/qcom/camss/camss-vfe-680.c
--- a/drivers/media/platform/qcom/camss/camss-vfe-680.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-680.c
@@ -14,6 +14,7 @@
 
 #include "camss.h"
 #include "camss-vfe.h"
+#include "camss-csid.h"
 
 #define VFE_TOP_IRQn_STATUS(vfe, n)		((vfe_is_lite(vfe) ? 0x1c : 0x44) + (n) * 4)
 #define VFE_TOP_IRQn_MASK(vfe, n)		((vfe_is_lite(vfe) ? 0x24 : 0x34) + (n) * 4)
@@ -199,6 +200,70 @@
 	writel(0, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm));
 }
 
+static int vfe_output_pause(struct vfe_device *vfe, struct vfe_output *output)
+{
+	u8 wm = output->wm[0].bus_client;
+
+	writel(0, vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm));
+	if (readl(vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm)))
+		return -EBUSY;
+	return 0;
+}
+
+static int vfe_output_quiesce(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct camss *camss = vfe->camss;
+	struct vfe_output *output = &line->output[0];
+	struct csid_device *csid;
+	struct media_pad *pad;
+	unsigned long flags;
+	u8 wm = output->wm[0].bus_client;
+	int ret;
+
+	if (camss->res->version != CAMSS_X1E80100 ||
+	    READ_ONCE(camss->stream_owner) != &output->video_out ||
+	    line->is_pix || line->num_outputs != 1 ||
+	    output->wm_num != 1 || vfe->id >= camss->res->csid_num ||
+	    vfe->stream_count != 1 || !vfe->irq ||
+	    wm != (vfe_is_lite(vfe) ? VFE_680_LITE_WM_RDI0 : VFE_680_WM_RDI0) +
+		  line->id)
+		return -EINVAL;
+
+	csid = &camss->csid[vfe->id];
+	pad = media_pad_remote_pad_first(&line->pads[MSM_VFE_PAD_SINK]);
+	if (!pad || pad->entity != &csid->subdev.entity)
+		return -ENOLINK;
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	ret = vfe_output_pause(vfe, output);
+	if (!ret)
+		output->gen2.wm_stopped = true;
+	/* An uncompleted programmed buffer is never released on failed start. */
+	if (!ret && (output->gen2.active_num || output->buf[0] || output->buf[1]))
+		ret = -EUCLEAN;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (ret)
+		return ret;
+	if (!READ_ONCE(csid->stream_quiesced) ||
+	    READ_ONCE(csid->stream_owner) != &output->video_out ||
+	    READ_ONCE(csid->stream_fault))
+		return -EUCLEAN;
+
+	vfe_disable_irq(vfe);
+	/* Publish IRQ masks before waiting for the handler to leave. */
+	wmb();
+	synchronize_irq(vfe->irq);
+	if (readl(vfe->base + VFE_BUS_WRITE_CLIENT_CFG(vfe, wm)) ||
+	    readl(vfe->base + VFE_TOP_IRQn_MASK(vfe, 0)) ||
+	    readl(vfe->base + VFE_TOP_IRQn_MASK(vfe, 1)) ||
+	    readl(vfe->base + VFE_BUS_IRQn_MASK(vfe, 0)) ||
+	    readl(vfe->base + VFE_BUS_IRQn_MASK(vfe, 1)))
+		return -EBUSY;
+
+	return 0;
+}
+
