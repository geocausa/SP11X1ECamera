@@ -219,6 +221,9 @@
 	/* Output based API - new and shiny */
 	void (*vfe_output_start)(struct vfe_device *vfe, struct vfe_output *output);
 	void (*vfe_output_stop)(struct vfe_device *vfe, struct vfe_output *output);
+	/* pause is IRQ-safe; quiesce runs outside output_lock. */
+	int (*vfe_output_pause)(struct vfe_device *vfe, struct vfe_output *output);
+	int (*vfe_output_quiesce)(struct vfe_line *line);
 	void (*vfe_output_buf_done)(struct vfe_device *vfe, struct vfe_output *output);
 	void (*vfe_output_update)(struct vfe_device *vfe, struct vfe_output *output,
 				  struct camss_buffer *buf);
@@ -295,6 +300,8 @@
 
 struct camss_buffer *vfe_buf_get_pending(struct vfe_output *output);
 
+int vfe_prepare_stop(struct vfe_line *line);
+
 int vfe_flush_buffers(struct camss_video *vid, enum vb2_buffer_state state);
 
 /*
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -792,6 +792,21 @@
 		return NULL;
 	}
 
+	/* Pause before returning the last programmed buffer: never replay its IOVA. */
+	if (ops->vfe_output_pause && output->gen2.active_num == 1 &&
+	    (output->state == VFE_OUTPUT_STOPPING || list_empty(&output->pending_bufs))) {
+		int ret = ops->vfe_output_pause(vfe, output);
+
+		if (ret) {
+			WRITE_ONCE(output->video_out.lifecycle.fault, true);
+			WRITE_ONCE(vfe->camss->stream_fault, true);
+			vb2_queue_error(&output->video_out.vb2_q);
+			dev_err_ratelimited(vfe->camss->dev, "RDI pause failed: %d\n", ret);
+			return NULL;
+		}
+		output->gen2.wm_stopped = true;
+	}
+
 	ready_buf->vb.vb2_buf.timestamp = ts;
 	ready_buf->vb.sequence = output->sequence++;
 
@@ -803,7 +818,8 @@
 	if (output->buf[0])
 		index = 1;
 
-	output->buf[index] = vfe_buf_get_pending(output);
+	output->buf[index] = output->state == VFE_OUTPUT_STOPPING ?
+		NULL : vfe_buf_get_pending(output);
 
 	if (output->buf[index]) {
 		if (ops->vfe_output_update)
@@ -815,6 +831,8 @@
 		ops->reg_update(vfe, line->id);
 	} else {
 		output->gen2.active_num--;
+		if (!output->gen2.active_num && output->state == VFE_OUTPUT_STOPPING)
+			complete(&output->drain_complete);
 	}
 
 	return ready_buf;
@@ -930,6 +948,7 @@
 
 	output->state = VFE_OUTPUT_ON;
 
+	output->gen2.wm_stopped = false;
 	output->sequence = 0;
 	output->wait_reg_update = 0;
 	reinit_completion(&output->reg_update);
@@ -1024,6 +1043,10 @@
 			ops->vfe_wm_update(vfe, output->wm[0].bus_client,
 					   buf->addr[0], line);
 		ops->reg_update(vfe, line->id);
+		if (ops->vfe_output_pause && output->gen2.wm_stopped) {
+			ops->vfe_output_start(vfe, output);
+			output->gen2.wm_stopped = false;
+		}
 	} else {
 		vfe_buf_add_pending(output, buf);
