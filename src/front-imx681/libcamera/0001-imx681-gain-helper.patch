+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <cmath>
+#include <iostream>
+
+#include "camera_sensor_helper.h"
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa;
+
+class Imx681HelperTest : public Test
+{
+protected:
+	int run() override
+	{
+		auto helper = CameraSensorHelperFactoryBase::create("imx681");
+		if (!helper || helper->blackLevel().has_value())
+			return TestFail;
+
+		/* Operating points from the independently verified IMX681 oracle. */
+		const struct {
+			unsigned int code;
+			double multiplier;
+		} points[] = {
+			{ 0, 1.0 }, { 512, 2.0 }, { 768, 4.0 },
+			{ 896, 8.0 }, { 960, 16.0 },
+		};
+		for (const auto &point : points) {
+			if (std::abs(helper->gain(point.code) - point.multiplier) > 1e-12 ||
+			    helper->gainCode(point.multiplier) != point.code)
+				return TestFail;
+		}
+
+		/* Integer conversion rounds down; no invented calibration. */
+		if (helper->gainCode(1.5) != 341 ||
+		    helper->gain(helper->gainCode(1.5)) > 1.5)
+			return TestFail;
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(Imx681HelperTest)
