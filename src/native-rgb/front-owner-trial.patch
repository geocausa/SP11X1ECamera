+int vfe680_native_front_snapshot(struct vfe_device *vfe, unsigned int group,
+				u32 consumed[NATIVE_OWNER_WMS])
+{
+	static const u8 wm[NATIVE_OWNER_WMS] = { 0, 1, 2, 3, 11, 12, 13, 14, 16 };
+	unsigned int i;
+
+	if (!vfe680_x1e_bus_target(vfe) ||
+	    !camss_x1e_native_front_owner_trial_allowed(vfe->camss) ||
+	    !consumed || group >= NATIVE_OWNER_GROUPS)
+		return -EINVAL;
+	memset(consumed, 0, NATIVE_OWNER_WMS * sizeof(*consumed));
+	for (i = 0; i < NATIVE_OWNER_WMS; i++)
+		if (native_owner_group_masks[group] & BIT(i))
+			consumed[i] = readl(vfe->base + VFE680_X1E_BUS_CLIENT_BASE +
+					   wm[i] * VFE680_X1E_BUS_CLIENT_STRIDE +
+					   VFE680_X1E_BUS_ADDR_STATUS0);
+	return 0;
+}
