+static void csid680_native_front_owner_reset(struct csid_device *csid)
+{
+	u64 epoch = ktime_get_ns();
+
+	/* One-use diagnostic: disarm history, drain any old handler, then reset. */
+	WRITE_ONCE(csid->native_front_owner.epoch, 0);
+	synchronize_irq(csid->irq);
+	spin_lock_init(&csid->native_front_owner_lock);
+	memset(&csid->native_front_owner, 0, sizeof(csid->native_front_owner));
+	csid->native_front_owner.last[0] = READ_ONCE(csid->x1e_buf_done_video_count);
+	csid->native_front_owner.last[1] = READ_ONCE(csid->x1e_buf_done_aec_bhist_count);
+	csid->native_front_owner.last[2] = READ_ONCE(csid->x1e_buf_done_tintless_count);
+	csid->native_front_owner.last[3] = READ_ONCE(csid->x1e_buf_done_awb_count);
+	csid->native_front_owner.last[4] = READ_ONCE(csid->x1e_buf_done_rs_count);
+	/* No IRQ reader sees an armed session before its history is initialized. */
+	smp_store_release(&csid->native_front_owner.epoch, epoch ? epoch : 1);
+}
+
+static void csid680_native_front_owner_latch(struct csid_device *csid, u32 status)
+{
+	static const u8 bit[NATIVE_OWNER_GROUPS] = { 0, 4, 5, 6, 9 };
+	u32 count[NATIVE_OWNER_GROUPS] = {
+		READ_ONCE(csid->x1e_buf_done_video_count),
+		READ_ONCE(csid->x1e_buf_done_aec_bhist_count),
+		READ_ONCE(csid->x1e_buf_done_tintless_count),
+		READ_ONCE(csid->x1e_buf_done_awb_count),
+		READ_ONCE(csid->x1e_buf_done_rs_count),
+	};
+	u32 consumed[NATIVE_OWNER_WMS];
+	unsigned long flags;
+	unsigned int group;
+	int ret;
+
+	if (!camss_x1e_native_front_owner_trial_allowed(csid->camss) ||
+	    !smp_load_acquire(&csid->native_front_owner.epoch))
+		return;
+	spin_lock_irqsave(&csid->native_front_owner_lock, flags);
+	for (group = 0; group < NATIVE_OWNER_GROUPS; group++) {
+		if (!(status & BIT(bit[group])))
+			continue;
+		ret = vfe680_native_front_snapshot(&csid->camss->vfe[1],
+						  group, consumed);
+		if (ret)
+			csid->native_front_owner.errors++;
+		else
+			native_owner_publish(&csid->native_front_owner, group,
+					     count[group] + 1,
+					     native_owner_group_masks[group], consumed);
+	}
+	spin_unlock_irqrestore(&csid->native_front_owner_lock, flags);
+}
+
+u64 csid680_native_front_owner_epoch(struct csid_device *csid)
+{
+	if (!csid || !camss_x1e_native_front_owner_trial_allowed(csid->camss))
+		return 0;
+	return smp_load_acquire(&csid->native_front_owner.epoch);
+}
+
+int csid680_native_front_owner_check(struct csid_device *csid, u64 epoch,
+				   unsigned int group, u32 sequence,
+				   const u32 expected[NATIVE_OWNER_WMS])
+{
+	unsigned long flags;
+	int ret;
+
+	if (!csid || !camss_x1e_native_front_owner_trial_allowed(csid->camss) ||
+	    !smp_load_acquire(&csid->native_front_owner.epoch))
+		return -EINVAL;
+	spin_lock_irqsave(&csid->native_front_owner_lock, flags);
+	ret = native_owner_check(&csid->native_front_owner, epoch,
+				 group, sequence, expected);
+	spin_unlock_irqrestore(&csid->native_front_owner_lock, flags);
+	return ret;
+}
