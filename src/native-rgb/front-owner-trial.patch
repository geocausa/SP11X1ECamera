+			"NATIVE_FRONT_OWNER_REJECT group=%u sequence=%u error=%d\n",
+			group, own->native_sequence[group] + 1, ret);
+		return ret;
+	}
+	own->native_sequence[group]++;
+	dev_info(own->native_vfe->camss->dev,
+		 "NATIVE_FRONT_OWNER_MATCH group=%u sequence=%u\n",
+		 group, own->native_sequence[group]);
+	return 0;
+}
