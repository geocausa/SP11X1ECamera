+static int vfe680_native_front_verify(struct vfe680_x1e_pix_ownership *own,
+				     unsigned int group,
+				     struct vfe680_x1e_pix_slot *slot)
+{
+	u32 expected[NATIVE_OWNER_WMS] = { 0 };
+	struct csid_device *csid;
+	int ret;
+
+	if (!own->native_vfe)
+		return 0;
+	if (!own->native_epoch)
+		return -ESTALE;
+	csid = &own->native_vfe->camss->csid[1];
+	if (group == VFE680_X1E_GROUP_VIDEO) {
+		if (!slot->video)
+			return -EPROTO;
+		expected[0] = slot->video->addr[0];
+		expected[1] = slot->video->addr[0] + 3686400;
+		expected[2] = slot->aux[VFE680_X1E_AUX_DS4].dma;
+		expected[3] = slot->aux[VFE680_X1E_AUX_DS16].dma;
+	}
+	expected[4] = slot->aux[VFE680_X1E_AUX_AEC_BE].dma;
+	expected[5] = slot->aux[VFE680_X1E_AUX_BHIST].dma;
+	expected[6] = slot->aux[VFE680_X1E_AUX_TL_BG].dma;
+	expected[7] = slot->aux[VFE680_X1E_AUX_AWB_BG].dma;
+	expected[8] = slot->aux[VFE680_X1E_AUX_RS].dma;
