+static void vfe680_x1e_linear_config_full(struct vfe_device *vfe, u8 client)
+{
+	void __iomem *cfg = vfe680_x1e_bus_reg(vfe, client, 0);
+	u32 rows = client ? 720 : 1440;
+
+	writel_relaxed(0, cfg + VFE680_X1E_BUS_CFG);
+	writel_relaxed(0, cfg + VFE680_X1E_BUS_BW_LIMIT); /* explicit bw_limiter disable */
+	writel_relaxed((rows << 16) | 2560, cfg + VFE680_X1E_BUS_IMAGE_CFG0);
+	writel_relaxed(3, cfg + VFE680_X1E_BUS_PACKER_CFG);
+	writel_relaxed(2560, cfg + VFE680_X1E_BUS_IMAGE_CFG2);
+	writel_relaxed(rows * 2560, cfg + VFE680_X1E_BUS_FRAME_INCR);
+	writel_relaxed(0, cfg + VFE680_X1E_BUS_IRQ_SUBSAMPLE_PERIOD);
+	writel_relaxed(1, cfg + VFE680_X1E_BUS_IRQ_SUBSAMPLE_PATTERN);
+	writel_relaxed(0, cfg + VFE680_X1E_BUS_FRAMEDROP_PERIOD);
+	writel_relaxed(1, cfg + VFE680_X1E_BUS_FRAMEDROP_PATTERN);
+}
