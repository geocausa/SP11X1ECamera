+/* VFE680 FULL line-based NV12 from public BUS-v3 authority. No UBWC
+ * register is written: a non-linear prior state must be rejected, not reset
+ * with invented zeros. The trial admits only a fresh, disabled nine-client bus.
+ */
+static int vfe680_x1e_linear_cold_state(struct vfe_device *vfe)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vfe680_x1e_windows_bus_client_order); i++) {
+		u8 c = vfe680_x1e_windows_bus_client_order[i];
+
+		if (readl(vfe680_x1e_bus_reg(vfe, c, VFE680_X1E_BUS_CFG)) &
+		    VFE_BUS_WRITE_CLIENT_CFG_EN)
+			return -EBUSY;
+	}
+	for (i = 0; i < 2; i++)
+		if (readl(vfe680_x1e_bus_reg(vfe, i, VFE680_X1E_BUS_MODE_CFG)) & BIT(0))
+			return -EOPNOTSUPP;
+	return 0;
+}
