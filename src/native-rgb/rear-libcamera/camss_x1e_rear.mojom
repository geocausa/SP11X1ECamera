module ipa.camss_x1e_rear;
import "include/libcamera/ipa/core.mojom";
interface IPACamssX1ERearInterface {
 init(libcamera.IPASettings settings) => (int32 ret);
 mapBuffers(array<libcamera.IPABuffer> buffers) => (int32 ret);
 unmapBuffers(array<uint32> ids);
 start() => (int32 ret);
 stop();
 [async] processStatistics(uint32 bufferId,uint64 stream,uint32 sequence,uint64 timestamp);
};
interface IPACamssX1ERearEventInterface {
 statisticsValidated(uint32 bufferId,uint64 stream,uint32 sequence,uint64 timestamp,
                     int32 ret,uint64 owner,uint64 generation);
};
