static int
e006o_rear_steady_singleton_lookup(void *ctx, u16 reg, u32 *value)
{
	unsigned int lo = 0;
	unsigned int hi = ARRAY_SIZE(e006o_rear_singletons);

	(void)ctx;
	if (!value)
		return -EINVAL;

	while (lo < hi) {
		unsigned int mid = lo + (hi - lo) / 2;
		const struct e006o_rear_singleton *s = &e006o_rear_singletons[mid];

		if (reg < s->reg) {
			hi = mid;
		} else if (reg > s->reg) {
			lo = mid + 1;
		} else {
			*value = s->value;
			return 0;
		}
	}

	return -ENOENT;
}

