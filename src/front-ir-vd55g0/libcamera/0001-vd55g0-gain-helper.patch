+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* VD55G0 sensor gain-unit and factory registration checks. */
+
+#include <cmath>
+#include <iostream>
+
+#include "camera_sensor_helper.h"
+#include "test.h"
+
+using namespace libcamera;
+using namespace libcamera::ipa;
+
+class Vd55g0HelperTest : public Test
+{
+protected:
+	int run() override
+	{
+		auto helper = CameraSensorHelperFactoryBase::create("vd55g0");
+		if (!helper) {
+			std::cerr << "VD55G0 helper was not registered" << std::endl;
+			return TestFail;
+		}
+
+		/* Independent documented operating points, not a second formula. */
+		const struct {
+			unsigned int code;
+			double multiplier;
+		} points[] = {
+			{ 0, 1.0 },
+			{ 16, 2.0 },
+			{ 24, 4.0 },
+			{ 28, 8.0 },
+		};
+		for (const auto &point : points) {
+			if (std::abs(helper->gain(point.code) - point.multiplier) > 1e-12 ||
+			    helper->gainCode(point.multiplier) != point.code) {
+				std::cerr << "Incorrect gain units at code " << point.code
+					  << std::endl;
+				return TestFail;
+			}
+		}
+
+		/* Fractional requests must quantize without exceeding the request. */
+		if (helper->gainCode(1.5) != 10 ||
+		    helper->gain(helper->gainCode(1.5)) > 1.5) {
+			std::cerr << "Unexpected fractional gain quantization" << std::endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(Vd55g0HelperTest)
