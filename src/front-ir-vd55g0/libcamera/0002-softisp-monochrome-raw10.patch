+			for (unsigned int x = 0; x < 4; ++x) {
+				const uint8_t *pixel = row + x * pixelBytes;
+				if (pixel[0] != expected[x] || pixel[1] != expected[x] ||
+				    pixel[2] != expected[x] || (alpha && pixel[3] != 255))
+					return TestFail;
+			}
+			for (unsigned int x = 4 * pixelBytes; x < output.stride; ++x) {
+				if (row[x] != 0)
+					return TestFail;
+			}
+		}
+		for (unsigned int i = output.frameSize; i < output.frameSize + 16; ++i) {
+			if (outputMem.mem()[i] != 0x5a)
+				return TestFail;
+		}
+		if (!observed.valid || observed.sum_.r() != 0 ||
+		    observed.sum_.g() != 0 || observed.sum_.b() != 0 ||
+		    observed.yHistogram[0] != 4 * height ||
+		    std::accumulate(observed.yHistogram.begin(), observed.yHistogram.end(), 0U) != 4 * height ||
+		    out.metadata().planes()[0].bytesused != output.frameSize)
+			return TestFail;
+		return TestPass;
+	}
+
+	int histogram()
+	{
+		GlobalConfiguration config;
+		SwStatsCpu stats(config);
+		StreamConfiguration input;
+		input.pixelFormat = formats::R10_CSI2P;
+		input.size = { 1024, 3 };
+		input.stride = 1296;
+		if (stats.configure(input))
+			return TestFail;
+		stats.setWindow(Rectangle(input.size));
+		SharedMem memory("mono-histogram", input.stride * input.size.height);
+		if (!memory)
+			return TestFail;
+		std::fill(memory.mem().begin(), memory.mem().end(), 0xff);
+		for (unsigned int y = 0; y < 3; ++y) {
+			for (unsigned int group = 0; group < 256; ++group) {
+				uint8_t *p = memory.mem().data() + y * input.stride + group * 5;
+				/* Four equal MSBs plus the independently known low-bit vector. */
+				p[0] = p[1] = p[2] = p[3] = group;
+				p[4] = 0xe4;
+			}
+		}
+		FrameBuffer buffer(std::vector<FrameBuffer::Plane>{ { memory.fd(), 0, unsigned(memory.mem().size()) } });
+		buffer._d()->metadata().status = FrameMetadata::FrameSuccess;
+		buffer._d()->metadata().planes()[0].bytesused = memory.mem().size();
+		stats.processFrame(0, 0, &buffer);
+		SwIspStats observed{};
+		if (pread(stats.getStatsFD().get(), &observed, sizeof(observed), 0) != sizeof(observed))
+			return TestFail;
+		if (!observed.valid || observed.sum_.r() != 391680 ||
+		    observed.sum_.g() != observed.sum_.r() || observed.sum_.b() != observed.sum_.r() ||
+		    !std::all_of(observed.yHistogram.begin(), observed.yHistogram.end(),
+				 [](uint32_t count) { return count == 48; }))
+			return TestFail;
+		stats.processFrame(1, 0, &buffer);
+		if (pread(stats.getStatsFD().get(), &observed, sizeof(observed), 0) != sizeof(observed) ||
+		    observed.valid)
+			return TestFail;
+		return TestPass;
+	}
+
+	int fullFrame(unsigned int blackIndex)
+	{
+		GlobalConfiguration config;
+		DebayerCpu converter(std::make_unique<SwStatsCpu>(config), config);
+		StreamConfiguration input;
+		input.pixelFormat = formats::R10_CSI2P;
+		input.size = { 644, 604 };
+		input.stride = 816;
+		StreamConfiguration output;
+		output.pixelFormat = formats::RGB888;
+		output.size = input.size;
+		std::tie(output.stride, output.frameSize) =
+			converter.strideAndFrameSize(output.pixelFormat, output.size);
+		if (converter.configure(input, { output }, false))
+			return TestFail;
+		SharedMem source("mono-full-input", input.stride * input.size.height);
+		SharedMem destination("mono-full-output", output.frameSize);
+		if (!source || !destination)
+			return TestFail;
+		std::fill(source.mem().begin(), source.mem().end(), 0xff);
+		/* Reproduce the dimensions and x+66 ramp observed on the SP11. */
+		for (unsigned int y = 0; y < input.size.height; ++y) {
+			for (unsigned int x = 0; x < input.size.width; x += 4) {
+				uint8_t *group = source.mem().data() + y * input.stride + x * 5 / 4;
+				for (unsigned int i = 0; i < 4; ++i)
+					group[i] = (x + i + 66) / 4;
+				group[4] = 0x4e; /* Low bits 2,3,0,1. */
+			}
+		}
+		FrameBuffer in(std::vector<FrameBuffer::Plane>{ { source.fd(), 0, unsigned(source.mem().size()) } });
+		FrameBuffer out(std::vector<FrameBuffer::Plane>{ { destination.fd(), 0, output.frameSize } });
+		in._d()->metadata().status = FrameMetadata::FrameSuccess;
+		in._d()->metadata().planes()[0].bytesused = source.mem().size();
+		DebayerParams params{};
+		params.gamma = 1;
+		params.contrastExp = 1;
+		params.gains = RGB<float>(1);
+		params.blackLevel = RGB<float>(blackIndex / 1024.0f);
+		converter.process(0, &in, &out, params);
+		if (out.metadata().status != FrameMetadata::FrameSuccess ||
+		    out.metadata().planes()[0].bytesused != output.frameSize)
+			return TestFail;
+		for (unsigned int y = 0; y < input.size.height; ++y) {
+			const uint8_t *row = destination.mem().data() + y * output.stride;
+			for (unsigned int x = 0; x < input.size.width; ++x) {
+				const int signal = std::max(int(x + 66) - int(blackIndex), 0);
+				const int expected = signal * 255 / (1023 - blackIndex);
+				if (std::abs(int(row[x * 3]) - expected) > 1 ||
+				    row[x * 3] != row[x * 3 + 1] || row[x * 3] != row[x * 3 + 2])
+					return TestFail;
+			}
+		}
+		return TestPass;
+	}
+
+	int run() override
+	{
+		const uint8_t high[] = { 255, 255, 255, 255, 0xe4 };
+		if (unpackMono10(high) != std::array<uint16_t, 4>{ 1020, 1021, 1022, 1023 })
+			return TestFail;
+		for (PixelFormat format : { formats::RGB888, formats::BGR888,
+					   formats::XRGB8888, formats::ARGB8888,
+					   formats::XBGR8888, formats::ABGR8888 }) {
+			for (unsigned int height : { 1U, 3U }) {
+				if (conversion(format, height, false, false) ||
+				    conversion(format, height, false, false, true)) {
+					std::cerr << "Mono conversion failed: " << format << " height=" << height << std::endl;
+					return TestFail;
+				}
+			}
+		}
+		if (conversion(formats::RGB888, 3, true, false) ||
+		    conversion(formats::RGB888, 3, false, true) ||
+		    conversion(formats::RGB888, 3, false, false, false, true) ||
+		    conversion(formats::RGB888, 3, false, false, false, false, true) || histogram() ||
+		    fullFrame(0) || fullFrame(64) || fullFrame(128))
+			return TestFail;
+
+		GlobalConfiguration config;
+		DebayerCpu converter(std::make_unique<SwStatsCpu>(config), config);
+		StreamConfiguration input;
+		input.pixelFormat = formats::R10_CSI2P;
+		input.size = { 4, 1 };
+		input.stride = 4;
+		StreamConfiguration output;
+		output.pixelFormat = formats::RGB888;
+		output.size = { 4, 1 };
+		output.stride = 16;
+		if (!converter.configure(input, { output }, false))
+			return TestFail;
+		input.size = { 6, 1 };
+		input.stride = 16;
+		if (!converter.configure(input, { output }, false))
+			return TestFail;
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(MonoProcessingTest)
