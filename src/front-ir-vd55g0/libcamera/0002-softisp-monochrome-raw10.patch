+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* CSI-2 packed monochrome sample decoding. */
+#pragma once
+
+#include <array>
+#include <stdint.h>
+
+namespace libcamera {
+
+/* The caller supplies one complete five-byte CSI-2 RAW10 group. */
+inline std::array<uint16_t, 4> unpackMono10(const uint8_t *src)
+{
+	return { uint16_t((src[0] << 2) | (src[4] & 3)),
+		 uint16_t((src[1] << 2) | ((src[4] >> 2) & 3)),
+		 uint16_t((src[2] << 2) | ((src[4] >> 4) & 3)),
+		 uint16_t((src[3] << 2) | (src[4] >> 6)) };
+}
+
+} /* namespace libcamera */
