 }
 
 static int dw9719_power_up(struct dw9719_device *dw9719, bool detect)
@@ -117,9 +127,16 @@
 	int ret;
 	int err;
 
+	/* The actuator's I2C interface may share the sensor's DOVDD rail. */
+	if (dw9719->vddio) {
+		ret = regulator_enable(dw9719->vddio);
+		if (ret)
+			return ret;
+	}
+
 	ret = regulator_enable(dw9719->regulator);
 	if (ret)
-		return ret;
+		goto err_disable_vddio;
 
 	/*
 	 * Need 100us to transition from SHUTDOWN to STANDBY.
@@ -150,7 +167,7 @@
 
 		ret = cci_read(dw9719->regmap, DW9719_INFO, &val, NULL);
 		if (ret < 0)
-			return ret;
+			goto err_power_down;
 
 		switch (val) {
 		case DW9719_ID:
