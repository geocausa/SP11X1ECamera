 		}
 
 props:
@@ -219,9 +237,19 @@
 	}
 
 	if (ret)
-		dw9719_power_down(dw9719);
+		goto err_power_down;
 
+	return 0;
+
+err_power_down:
+	/* Preserve the original I2C error while releasing both supplies. */
+	dw9719_power_down(dw9719);
 	return ret;
+
+err_disable_vddio:
+	if (dw9719->vddio)
+		regulator_disable(dw9719->vddio);
