From a73bce281ad0f7e2e1a6c6a4bb7826b9f5022f67 Mon Sep 17 00:00:00 2001
From: George Neacsu <geocausa@gmail.com>
Date: Sat, 21 Nov 2026 22:08:09 +0000
Subject: [PATCH RFC 3/3] arm64: dts: qcom: denali-oled: connect rear DW9800K VCM

On the X1E80100 Surface Pro 11 OLED, link the OV13858 sensor to its
DW9800K lens actuator on CCI0 master1 address 0x0c.

Expose the independently powered PM8550 L16B 2.912 V VDD supply
and the PM8010 L6M 1.8 V I/O supply shared with OV13858 DOVDD.
The existing L16B input parent is retained.

Tested on Oaklee v15 kernel 7.3.0-jg-1sp11v15-qcom-x1e:
actuator probe and focus writes, 0/1/2/1/0 shared L6M votes,
uninterrupted 240-frame capture with VCM open/close, and
post-PM camera capture.

Signed-off-by: George Neacsu <geocausa@gmail.com>
---
 .../dts/qcom/x1e80100-microsoft-denali-oled.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled.dts
index ffb1c11..044f068 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-denali-oled.dts
@@ -69,6 +69,14 @@
 
 &apps_rsc {
 	regulators-0 {
+		/* Rear DW9800K VCM VDD; shared I/O is PM8010 L6M. */
+		vreg_l16b_2p9: ldo16 {
+			regulator-name = "vreg_l16b_2p9";
+			regulator-min-microvolt = <2912000>;
+			regulator-max-microvolt = <2912000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l7b_2p8: ldo7 {
 			regulator-name = "vreg_l7b_2p8";
 			regulator-min-microvolt = <2800000>;
@@ -202,6 +210,7 @@
 	ov13858: camera@10 {
 		compatible = "ovti,ov13858";
 		reg = <0x10>;
+		lens-focus = <&rear_vcm>;
 
 		reset-gpios = <&tlmm 110 GPIO_ACTIVE_LOW>;
 		pinctrl-0 = <&cam_rear_default>;
@@ -227,6 +236,14 @@
 			};
 		};
 	};
+
+	/* DW9800K actuator on CCI0 master1; L6M is shared with OV13858. */
+	rear_vcm: actuator@c {
+		compatible = "dongwoon,dw9800k";
+		reg = <0x0c>;
+		vdd-supply = <&vreg_l16b_2p9>;
+		vddio-supply = <&vreg_l6m_1p8>;
+	};
 };
 
 &cci0_i2c0 {
-- 
2.53.0

