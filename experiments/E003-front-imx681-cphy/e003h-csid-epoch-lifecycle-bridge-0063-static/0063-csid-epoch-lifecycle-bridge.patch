+int csid680_x1e_front_ipp_poll_epoch0(struct csid_device *csid,
+				       unsigned long timeout_us)
+{
+	u32 status;
+
+	if (!csid || !timeout_us || !__csid_sp11_front_ipp_mode0(csid))
+		return -EINVAL;
+
+	/*
+	 * Windows advances the front IFE Epoch lifecycle from its CSID IST
+	 * message bit21. Linux already latches that same IPP IRQ status in the
+	 * ISR before clearing hardware, so consume the software latch here.
+	 * This intentionally performs no MMIO read or write.
+	 */
+	return read_poll_timeout(READ_ONCE, status,
+				 status & CSID_IPP_CAMIF_EPOCH0, 10, timeout_us,
+				 false, csid->x1e_ipp_irq_seen_or);
+}
