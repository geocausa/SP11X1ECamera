+
+int vfe680_x1e_pix_runtime_retire_video(struct vfe680_x1e_pix_runtime *runtime,
+					unsigned int expected_slot,
+					struct camss_buffer **video_done)
+{
+	struct camss_buffer *done;
+	bool reusable;
+	unsigned int index;
+	int ret;
+
+	if (!runtime || !video_done || expected_slot >= VFE680_X1E_PIX_SLOT_COUNT)
+		return -EINVAL;
+	ret = vfe680_x1e_pix_ownership_complete(&runtime->ownership, 0x03,
+						&index, &done, &reusable);
+	if (ret)
+		return ret;
+	if (index != expected_slot || !done || reusable)
+		return -EPROTO;
+
+	*video_done = done;
+	return 0;
+}
+
+int vfe680_x1e_pix_runtime_retire_aux(struct vfe680_x1e_pix_runtime *runtime,
+				      unsigned int expected_slot)
+{
+	static const u32 event_id[] = { 0x0d, 0x0e, 0x10, 0x12 };
+	struct camss_buffer *done;
+	bool reusable = false;
+	unsigned int index;
+	unsigned int i;
+	int ret;
+
+	if (!runtime || expected_slot >= VFE680_X1E_PIX_SLOT_COUNT)
+		return -EINVAL;
+
+	/*
+	 * Hardware arrival order is intentionally unconstrained. The caller waits
+	 * until all five CSID completion generations have arrived, then this only
+	 * retires one FIFO entry from each remaining independent ownership group.
+	 */
+	for (i = 0; i < ARRAY_SIZE(event_id); i++) {
+		done = NULL;
+		reusable = false;
+		ret = vfe680_x1e_pix_ownership_complete(&runtime->ownership, event_id[i],
+						&index, &done, &reusable);
+		if (ret)
+			return ret;
+		if (index != expected_slot || done ||
+		    (i + 1 < ARRAY_SIZE(event_id) && reusable))
+			return -EPROTO;
+	}
+
+	return reusable ? 0 : -EPROTO;
+}
+
+int vfe680_x1e_pix_runtime_rebind(struct vfe680_x1e_pix_runtime *runtime,
+				    unsigned int slot,
+				    struct camss_buffer *video)
+{
+	if (!runtime || !video || slot >= VFE680_X1E_PIX_SLOT_COUNT)
+		return -EINVAL;
+
+	/* Pure ownership/DMA-address rebinding; BUS MMIO remains caller-owned. */
+	return vfe680_x1e_pix_ownership_begin(&runtime->ownership, slot, video,
+					     &runtime->iovas[slot]);
+}
