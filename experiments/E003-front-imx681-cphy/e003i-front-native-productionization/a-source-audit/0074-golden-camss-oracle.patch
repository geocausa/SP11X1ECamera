+static int camss_rtcdm1_corpus_alloc(struct device *dev, size_t size,
+				     void **cpu, dma_addr_t *dma)
+{
+	void *p;
+	dma_addr_t d;
+
+	p = dma_alloc_coherent(dev, size, &d, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	if ((u64)d + size - 1 > U32_MAX) {
+		dma_free_coherent(dev, size, p, d);
+		return -ERANGE;
+	}
+
+	memset(p, 0, size);
+	*cpu = p;
+	*dma = d;
+	return 0;
+}
