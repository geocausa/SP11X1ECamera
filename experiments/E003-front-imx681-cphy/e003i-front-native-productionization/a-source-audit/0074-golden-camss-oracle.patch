+	u16 main_bytes;
+	u16 command_count;
+	u16 register_write_count;
+	u8 dmi_count;
+	u8 dynamic_register_count;
+	u8 observed_samples;
+};
+
+struct camss_x1e_epoch0_cdm_batch_contract {
+	u16 bl_bytes[CAMSS_X1E_EPOCH0_CDM_STEADY_BL_COUNT];
