+	struct camss_buffer *video_done_sixth;
+	bool epoch0_seen;
+	bool epoch0_next_seen;
+	bool epoch0_steady_seen;
+	bool epoch0_steady_next_seen;
+	bool epoch0_steady_third_seen;
+	bool video_seen;
+	bool video_next_seen;
