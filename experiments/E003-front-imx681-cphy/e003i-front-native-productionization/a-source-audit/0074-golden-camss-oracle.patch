+static int camss_x1e_pix_runner_stream(struct v4l2_subdev *sd, bool enable)
+{
+	int ret;
+
+	if (!sd)
+		return -EINVAL;
+
+	ret = v4l2_subdev_call(sd, video, s_stream, enable);
+	if (ret == -ENOIOCTLCMD)
+		return -EOPNOTSUPP;
+
+	return ret;
+}
