+/* Retention only: no probe, vb2, ioctl or stream path references this table. */
+static const struct camss_x1e_pix_runner_static_ops
+camss_x1e_pix_runner_recipe __used = {
+	.run_once = camss_x1e_pix_runner_once,
+};
