+static bool camss_x1e_pix_iq_video(struct camss_video *video)
+{
+	struct camss *camss;
+
+	if (!video || !video->camss || !video->camss->res)
+		return false;
+	camss = video->camss;
+
+	return camss->res->version == CAMSS_X1E80100 && camss->res->vfe_num > 1 &&
+	       video == &camss->vfe[1].line[VFE_LINE_PIX].video_out;
+}
+
+int camss_x1e_pix_iq_session_open(struct camss_video *video)
+{
+	if (!camss_x1e_pix_iq_video(video))
+		return -ENODEV;
+	if (READ_ONCE(video->x1e_pix_runner_pinned) ||
+	    READ_ONCE(video->x1e_pix_worker_started) ||
+	    READ_ONCE(video->x1e_pix_live_active))
+		return -EBUSY;
+
+	/* A new exclusive fd always begins with an empty, closed producer FIFO. */
+	camss_x1e_pix_iq_provider_close(video);
+	camss_x1e_pix_iq_provider_purge(video);
+	return 0;
+}
+
+void camss_x1e_pix_iq_session_close(struct camss_video *video)
+{
+	if (!camss_x1e_pix_iq_video(video) ||
+	    READ_ONCE(video->x1e_pix_runner_pinned) ||
+	    READ_ONCE(video->x1e_pix_worker_started) ||
+	    READ_ONCE(video->x1e_pix_live_active))
+		return;
+
+	camss_x1e_pix_iq_provider_close(video);
+	camss_x1e_pix_iq_provider_purge(video);
+}
+
+int camss_x1e_pix_iq_submit(struct camss_video *video,
+			    const u8 *capsule, size_t capsule_size)
+{
+	bool closed;
+	int ret;
+
+	if (!camss_x1e_pix_iq_video(video) || !capsule ||
+	    capsule_size != CAMSS_X1E_PIX_CAPSULE_BYTES)
+		return -EINVAL;
+	if (READ_ONCE(video->x1e_pix_runner_pinned) ||
+	    READ_ONCE(video->x1e_pix_worker_started) ||
+	    READ_ONCE(video->x1e_pix_live_active) || video->vb2_q.streaming)
+		return -EBUSY;
+
+	mutex_lock(&video->x1e_pix_iq_lock);
+	closed = video->x1e_pix_iq_closed;
+	mutex_unlock(&video->x1e_pix_iq_lock);
+
+	if (closed) {
+		ret = camss_x1e_pix_iq_provider_open(video,
+						 CAMSS_X1E_PIX_IQ_FIRST_STEADY_REQUEST);
+		if (ret)
+			return ret;
+	}
+
+	ret = camss_x1e_pix_iq_provider_enqueue(video, capsule, capsule_size);
+	if (ret) {
+		/* Any producer protocol error invalidates the partial sequence. */
+		camss_x1e_pix_iq_provider_close(video);
+		camss_x1e_pix_iq_provider_purge(video);
+	}
+	return ret;
+}
