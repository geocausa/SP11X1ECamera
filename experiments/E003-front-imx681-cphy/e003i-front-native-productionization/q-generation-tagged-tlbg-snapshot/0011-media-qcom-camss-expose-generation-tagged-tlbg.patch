+int vfe680_x1e_pix_runtime_tlbg_data(struct vfe680_x1e_pix_runtime *runtime,
+				     unsigned int expected_slot,
+				     const void **data, size_t *size)
+{
+	struct vfe680_x1e_pix_slot *slot;
+	struct vfe680_x1e_aux_buffer *tlbg;
+
+	if (!runtime || !data || !size ||
+	    expected_slot >= VFE680_X1E_PIX_SLOT_COUNT)
+		return -EINVAL;
+
+	slot = &runtime->ownership.slot[expected_slot];
+	if (!runtime->ownership.allocated || !slot->in_use ||
+	    !(slot->pending_mask & VFE680_X1E_DONE_TINTLESS_BG))
+		return -EPROTO;
+	tlbg = &slot->aux[VFE680_X1E_AUX_TL_BG];
+	if (!tlbg->cpu || tlbg->size < CAMSS_X1E_TLBG_RAW_BYTES)
+		return -EPROTO;
+
+	*data = tlbg->cpu;
+	*size = CAMSS_X1E_TLBG_RAW_BYTES;
+	return 0;
+}
