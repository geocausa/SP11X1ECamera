+static int camss_x1e_pix_publish_tlbg(struct camss_video *video,
+				      struct vfe680_x1e_pix_runtime *runtime,
+				      unsigned int slot, u32 source_seq)
+{
+	const void *raw;
+	size_t raw_size;
+	int ret;
+
+	if (!video)
+		return 0;
+	ret = vfe680_x1e_pix_runtime_tlbg_data(runtime, slot, &raw, &raw_size);
+	if (ret)
+		return ret;
+
+	/*
+	 * The caller has observed this TL_BG completion generation and ownership
+	 * still pins the slot. Copy before aux retirement can make DMA reusable.
+	 */
+	return camss_x1e_tlbg_publish(video, raw, raw_size, source_seq, slot);
+}
