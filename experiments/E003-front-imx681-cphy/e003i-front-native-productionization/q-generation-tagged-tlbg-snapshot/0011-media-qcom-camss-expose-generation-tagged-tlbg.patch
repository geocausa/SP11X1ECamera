+void camss_x1e_tlbg_reset(struct camss_video *video)
+{
+	if (!video || !video->x1e_tlbg_snapshot)
+		return;
+
+	mutex_lock(&video->x1e_tlbg_lock);
+	memzero_explicit(video->x1e_tlbg_snapshot, CAMSS_X1E_TLBG_RAW_BYTES);
+	video->x1e_tlbg_source_seq = 0;
+	video->x1e_tlbg_slot = 0;
+	video->x1e_tlbg_valid = false;
+	mutex_unlock(&video->x1e_tlbg_lock);
+}
+
+int camss_x1e_tlbg_publish(struct camss_video *video, const void *raw,
+			   size_t raw_size, u32 source_seq, u32 slot)
+{
+	if (!video || !raw || !video->x1e_tlbg_snapshot ||
+	    raw_size != CAMSS_X1E_TLBG_RAW_BYTES || !source_seq)
+		return -EINVAL;
+
+	mutex_lock(&video->x1e_tlbg_lock);
+	memcpy(video->x1e_tlbg_snapshot, raw, CAMSS_X1E_TLBG_RAW_BYTES);
+	video->x1e_tlbg_generation++;
+	if (!video->x1e_tlbg_generation)
+		video->x1e_tlbg_generation = 1;
+	video->x1e_tlbg_source_seq = source_seq;
+	video->x1e_tlbg_slot = slot;
+	video->x1e_tlbg_valid = true;
+	mutex_unlock(&video->x1e_tlbg_lock);
+	return 0;
+}
+
+static int video_x1e_tlbg_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct camss_video *video = container_of(ctrl->handler,
+						 struct camss_video, ctrl_handler);
+	struct camss_x1e_tlbg_snapshot_header header;
+	u8 *out;
+
+	if (ctrl->id != V4L2_CID_QCOM_CAMSS_X1E_TLBG_SNAPSHOT ||
+	    !video_is_x1e_front_pix(video) || !video->x1e_tlbg_snapshot)
+		return -EINVAL;
+
+	mutex_lock(&video->x1e_tlbg_lock);
+	if (!video->x1e_tlbg_valid) {
+		mutex_unlock(&video->x1e_tlbg_lock);
+		return -EAGAIN;
+	}
+
+	header.magic = cpu_to_le32(CAMSS_X1E_TLBG_SNAPSHOT_MAGIC);
+	header.version = cpu_to_le16(CAMSS_X1E_TLBG_SNAPSHOT_VERSION);
+	header.header_bytes = cpu_to_le16(sizeof(header));
+	header.generation = cpu_to_le64(video->x1e_tlbg_generation);
+	header.source_seq = cpu_to_le32(video->x1e_tlbg_source_seq);
+	header.slot = cpu_to_le32(video->x1e_tlbg_slot);
+	header.raw_bytes = cpu_to_le32(CAMSS_X1E_TLBG_RAW_BYTES);
+	header.flags = cpu_to_le32(CAMSS_X1E_TLBG_SNAPSHOT_F_LATEST);
+	out = ctrl->p_new.p_u8;
+	memcpy(out, &header, sizeof(header));
+	memcpy(out + sizeof(header), video->x1e_tlbg_snapshot,
+	       CAMSS_X1E_TLBG_RAW_BYTES);
+	mutex_unlock(&video->x1e_tlbg_lock);
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops video_x1e_tlbg_ctrl_ops = {
+	.g_volatile_ctrl = video_x1e_tlbg_g_volatile_ctrl,
+};
