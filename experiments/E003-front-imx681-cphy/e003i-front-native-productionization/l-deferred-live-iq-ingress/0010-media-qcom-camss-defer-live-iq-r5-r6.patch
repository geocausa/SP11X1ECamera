+static int camss_x1e_pix_iq_provider_next_steady(
+	struct camss *camss, struct camss_video *video, u64 expected_request_id,
+	struct camss_x1e_epoch0_materialized *steady)
+{
+	struct camss_x1e_pix_capsule_inputs *inputs;
+	struct camss_x1e_pix_iq_packet *packet = NULL;
+	int ret;
+
+	if (!camss || !video || !steady || steady->materialized)
+		return -EINVAL;
+	inputs = kzalloc_obj(*inputs, GFP_KERNEL);
+	if (!inputs)
+		return -ENOMEM;
+
+	/*
+	 * Do not sleep across a live Epoch0 boundary. The producer must have the
+	 * next request ready before this gate; otherwise fail closed and unwind.
+	 */
+	if (READ_ONCE(video->x1e_pix_stop_requested)) {
+		ret = -ECANCELED;
+		goto out_free;
+	}
+	mutex_lock(&video->x1e_pix_iq_lock);
+	if (list_empty(&video->x1e_pix_iq_pending)) {
+		ret = video->x1e_pix_iq_closed ? -ESHUTDOWN : -EAGAIN;
+		mutex_unlock(&video->x1e_pix_iq_lock);
+		goto out_free;
+	}
+	packet = list_first_entry(&video->x1e_pix_iq_pending,
+				  struct camss_x1e_pix_iq_packet, node);
+	list_del(&packet->node);
+	video->x1e_pix_iq_depth--;
+	if (packet->request_id != expected_request_id ||
+	    packet->request_id != video->x1e_pix_iq_last_dequeued + 1) {
+		ret = -EPROTO;
+		mutex_unlock(&video->x1e_pix_iq_lock);
+		goto out_packet;
+	}
+	video->x1e_pix_iq_last_dequeued = packet->request_id;
+	mutex_unlock(&video->x1e_pix_iq_lock);
+	ret = camss_x1e_pix_capsule_parse(packet->capsule, packet->capsule_size, inputs);
+	if (ret)
+		goto out_packet;
+	if (inputs->steady.subrequest || inputs->steady.request_id != expected_request_id) {
+		ret = -EPROTO;
+		goto out_packet;
+	}
+
+	/* R5/R6 consume only the steady section; startup/priming stay R4-owned. */
+	ret = camss_x1e_epoch0_materialize(camss, steady, &inputs->steady);
+
+out_packet:
+	camss_x1e_pix_iq_packet_release(packet);
+out_free:
+	kfree(inputs);
+	return ret;
+}
