+static int video_x1e_3a_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct camss_video *video = container_of(ctrl->handler,
+						 struct camss_video, ctrl_handler);
+	struct camss_x1e_3a_snapshot_header header = {};
+	u8 *out;
+
+	if (ctrl->id != V4L2_CID_QCOM_CAMSS_X1E_3A_SNAPSHOT ||
+	    !video_is_x1e_front_pix(video) || !video->x1e_3a_snapshot)
+		return -EINVAL;
+
+	mutex_lock(&video->x1e_3a_lock);
+	if (!video->x1e_3a_valid) {
+		mutex_unlock(&video->x1e_3a_lock);
+		return -EAGAIN;
+	}
+
+	header.magic = cpu_to_le32(CAMSS_X1E_3A_SNAPSHOT_MAGIC);
+	header.version = cpu_to_le16(CAMSS_X1E_3A_SNAPSHOT_VERSION);
+	header.header_bytes = cpu_to_le16(sizeof(header));
+	header.generation = cpu_to_le64(video->x1e_3a_generation);
+	header.source_seq = cpu_to_le32(video->x1e_3a_source_seq);
+	header.slot = cpu_to_le32(video->x1e_3a_slot);
+	header.aec_be_offset = cpu_to_le32(0);
+	header.aec_be_bytes = cpu_to_le32(CAMSS_X1E_3A_AEC_BE_RAW_BYTES);
+	header.bhist_offset = cpu_to_le32(CAMSS_X1E_3A_AEC_BE_RAW_BYTES);
+	header.bhist_bytes = cpu_to_le32(CAMSS_X1E_3A_BHIST_RAW_BYTES);
+	header.awb_bg_offset = cpu_to_le32(CAMSS_X1E_3A_AEC_BE_RAW_BYTES +
+					  CAMSS_X1E_3A_BHIST_RAW_BYTES);
+	header.awb_bg_bytes = cpu_to_le32(CAMSS_X1E_3A_AWB_BG_RAW_BYTES);
+	header.flags = cpu_to_le32(CAMSS_X1E_3A_SNAPSHOT_F_LATEST);
+	out = ctrl->p_new.p_u8;
+	memcpy(out, &header, sizeof(header));
+	memcpy(out + sizeof(header), video->x1e_3a_snapshot,
+	       CAMSS_X1E_3A_RAW_BYTES);
+	mutex_unlock(&video->x1e_3a_lock);
+	return 0;
+}
