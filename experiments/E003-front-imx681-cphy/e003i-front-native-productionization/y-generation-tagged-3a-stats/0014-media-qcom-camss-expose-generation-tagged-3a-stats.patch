+
+	if (!video)
+		return 0;
+	ret = vfe680_x1e_pix_runtime_3a_data(runtime, slot,
+					     &aec_be, &aec_be_size,
+					     &bhist, &bhist_size,
+					     &awb_bg, &awb_bg_size);
+	if (ret)
+		return ret;
+
+	/*
+	 * poll_all_done() has observed AEC/BHist and AWB completion for this
+	 * source generation. Ownership still pins all three DMA buffers until
+	 * retire_aux(), so copy their exact active prefixes before slot reuse.
+	 */
+	return camss_x1e_3a_publish(video, aec_be, aec_be_size,
+				    bhist, bhist_size, awb_bg, awb_bg_size,
+				    source_seq, slot);
+}
