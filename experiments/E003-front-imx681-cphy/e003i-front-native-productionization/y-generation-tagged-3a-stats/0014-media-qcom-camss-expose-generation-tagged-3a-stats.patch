+static int camss_x1e_pix_publish_3a(struct camss_video *video,
+				    struct vfe680_x1e_pix_runtime *runtime,
+				    unsigned int slot, u32 source_seq)
+{
+	const void *aec_be, *bhist, *awb_bg;
+	size_t aec_be_size, bhist_size, awb_bg_size;
