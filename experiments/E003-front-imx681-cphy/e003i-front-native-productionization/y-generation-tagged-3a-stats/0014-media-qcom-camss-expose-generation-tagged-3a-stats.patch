+int vfe680_x1e_pix_runtime_3a_data(struct vfe680_x1e_pix_runtime *runtime,
+				   unsigned int expected_slot,
+				   const void **aec_be, size_t *aec_be_size,
+				   const void **bhist, size_t *bhist_size,
+				   const void **awb_bg, size_t *awb_bg_size)
+{
+	struct vfe680_x1e_pix_slot *slot;
+	struct vfe680_x1e_aux_buffer *aec, *hist, *awb;
+	u8 required = VFE680_X1E_DONE_AEC_BE_BHIST | VFE680_X1E_DONE_AWB_BG;
+
+	if (!runtime || !aec_be || !aec_be_size || !bhist || !bhist_size ||
+	    !awb_bg || !awb_bg_size || expected_slot >= VFE680_X1E_PIX_SLOT_COUNT)
+		return -EINVAL;
+
+	slot = &runtime->ownership.slot[expected_slot];
+	if (!runtime->ownership.allocated || !slot->in_use ||
+	    (slot->pending_mask & required) != required)
+		return -EPROTO;
+	aec = &slot->aux[VFE680_X1E_AUX_AEC_BE];
+	hist = &slot->aux[VFE680_X1E_AUX_BHIST];
+	awb = &slot->aux[VFE680_X1E_AUX_AWB_BG];
+	if (!aec->cpu || aec->size < CAMSS_X1E_3A_AEC_BE_RAW_BYTES ||
+	    !hist->cpu || hist->size < CAMSS_X1E_3A_BHIST_RAW_BYTES ||
+	    !awb->cpu || awb->size < CAMSS_X1E_3A_AWB_BG_RAW_BYTES)
+		return -EPROTO;
+
+	*aec_be = aec->cpu;
+	*aec_be_size = CAMSS_X1E_3A_AEC_BE_RAW_BYTES;
+	*bhist = hist->cpu;
+	*bhist_size = CAMSS_X1E_3A_BHIST_RAW_BYTES;
+	*awb_bg = awb->cpu;
+	*awb_bg_size = CAMSS_X1E_3A_AWB_BG_RAW_BYTES;
+	return 0;
+}
