+void camss_x1e_3a_reset(struct camss_video *video)
+{
+	if (!video || !video->x1e_3a_snapshot)
+		return;
+
+	mutex_lock(&video->x1e_3a_lock);
+	memzero_explicit(video->x1e_3a_snapshot, CAMSS_X1E_3A_RAW_BYTES);
+	video->x1e_3a_source_seq = 0;
+	video->x1e_3a_slot = 0;
+	video->x1e_3a_valid = false;
+	mutex_unlock(&video->x1e_3a_lock);
+}
+
+int camss_x1e_3a_publish(struct camss_video *video,
+			 const void *aec_be, size_t aec_be_size,
+			 const void *bhist, size_t bhist_size,
+			 const void *awb_bg, size_t awb_bg_size,
+			 u32 source_seq, u32 slot)
+{
+	u8 *out;
+
+	if (!video || !aec_be || !bhist || !awb_bg || !video->x1e_3a_snapshot ||
+	    aec_be_size != CAMSS_X1E_3A_AEC_BE_RAW_BYTES ||
+	    bhist_size != CAMSS_X1E_3A_BHIST_RAW_BYTES ||
+	    awb_bg_size != CAMSS_X1E_3A_AWB_BG_RAW_BYTES || !source_seq)
+		return -EINVAL;
+
+	mutex_lock(&video->x1e_3a_lock);
+	out = video->x1e_3a_snapshot;
+	memcpy(out, aec_be, CAMSS_X1E_3A_AEC_BE_RAW_BYTES);
+	out += CAMSS_X1E_3A_AEC_BE_RAW_BYTES;
+	memcpy(out, bhist, CAMSS_X1E_3A_BHIST_RAW_BYTES);
+	out += CAMSS_X1E_3A_BHIST_RAW_BYTES;
+	memcpy(out, awb_bg, CAMSS_X1E_3A_AWB_BG_RAW_BYTES);
+	video->x1e_3a_generation++;
+	if (!video->x1e_3a_generation)
+		video->x1e_3a_generation = 1;
+	video->x1e_3a_source_seq = source_seq;
+	video->x1e_3a_slot = slot;
+	video->x1e_3a_valid = true;
+	mutex_unlock(&video->x1e_3a_lock);
+	return 0;
+}
