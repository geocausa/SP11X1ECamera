+
+	return READ_ONCE(csid->x1e_ipp_epoch0_count);
+}
+
+int csid680_x1e_front_poll_next_epoch0(struct csid_device *csid, u32 after_seq,
+				       unsigned long timeout_us)
+{
+	u32 seq;
+	int ret;
+
+	if (!csid || !after_seq || !timeout_us ||
+	    !__csid_sp11_front_ipp_mode0(csid))
+		return -EINVAL;
+
+	/*
+	 * Windows paces replay3 from the next CSID Epoch0 after the first VIDEO.
+	 * The ISR already reads IPP status, so wait only on its software generation.
+	 */
+	ret = read_poll_timeout(READ_ONCE, seq, seq != after_seq, 10, timeout_us,
+				false, csid->x1e_ipp_epoch0_count);
+	if (ret)
+		return ret;
+
+	return seq == after_seq + 1 ? 0 : -EPROTO;
+}
