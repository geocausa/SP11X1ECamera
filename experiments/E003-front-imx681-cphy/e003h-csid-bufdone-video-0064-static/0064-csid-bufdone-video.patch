+u32 csid680_x1e_front_video_seq(struct csid_device *csid)
+{
+	if (!csid || !__csid_sp11_front_ipp_mode0(csid))
+		return 0;
+
+	return READ_ONCE(csid->x1e_buf_done_video_count);
+}
+
+int csid680_x1e_front_poll_video(struct csid_device *csid, u32 after_seq,
+				 unsigned long timeout_us)
+{
+	u32 seq;
+
+	if (!csid || !timeout_us || !__csid_sp11_front_ipp_mode0(csid))
+		return -EINVAL;
+
+	/*
+	 * Same-machine Windows maps CSID BUF_DONE_IRQ_STATUS bit0 directly to
+	 * IFE VIDEO event 3. The first bit0 is co-latched with first Epoch0, so
+	 * the bounded runner snapshots that generation at Epoch0 and waits for
+	 * the next bit0 after BUS retarget + replay2. No MMIO access is added.
+	 */
+	return read_poll_timeout(READ_ONCE, seq, seq != after_seq, 10,
+				 timeout_us, false,
+				 csid->x1e_buf_done_video_count);
+}
