+		{ .main_bytes = 0x083c, .command_count = 43,
+		  .register_write_count = 429, .dmi_count = 12,
+		  .dynamic_register_count = 14, .observed_samples = 46 },
+		{ .main_bytes = 0x06b8, .command_count = 35,
