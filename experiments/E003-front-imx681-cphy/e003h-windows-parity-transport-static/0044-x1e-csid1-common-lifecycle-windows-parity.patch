@@ -7550,8 +7557,8 @@
 out_unwind:
 	if (frame_done) {
 		/* Proven normal host stop prefix: CSID1 -> BUS/IFE -> RT-CDM. */
-		if (csid_streaming || csid_prepared) {
-			stop_ret = camss_x1e_pix_runner_stream(&csid->subdev, false);
+		if (csid_streaming || csid_configured) {
