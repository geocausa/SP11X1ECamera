+	for (i = 0; i < ARRAY_SIZE(camss_x1e_epoch0_payloads); i++)
+		if (camss_x1e_epoch0_payloads[i].module == module &&
+		    camss_x1e_epoch0_payloads[i].payload == payload)
+			return &camss_x1e_epoch0_payloads[i];
+
+	return NULL;
+}
