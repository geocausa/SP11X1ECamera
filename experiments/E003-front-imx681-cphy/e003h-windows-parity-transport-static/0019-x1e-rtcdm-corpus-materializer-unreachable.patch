+	{ .packet = 2, .payload = 8, .field = 0x154 },
+	{ .packet = 2, .payload = 13, .field = 0x1c8 },
+	{ .packet = 2, .payload = 14, .field = 0x264 },
+	{ .packet = 2, .payload = 12, .field = 0x6b8 },
+	{ .packet = 2, .payload = 2, .field = 0x844 },
+	{ .packet = 2, .payload = 2, .field = 0x850 },
