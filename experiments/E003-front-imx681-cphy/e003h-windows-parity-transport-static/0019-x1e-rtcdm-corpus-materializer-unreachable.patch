+
+static const struct camss_rtcdm1_corpus_dynamic_patch
+camss_rtcdm1_corpus_dynamic[CAMSS_RTCDM1_CORPUS_DYNAMIC_COUNT] = {
+	{ .packet = 0, .field = 0xe84, .reg = 0x8c },
+	{ .packet = 0, .field = 0x48, .reg = 0x3b70 },
+	{ .packet = 0, .field = 0xa4, .reg = 0x3d78 },
+	{ .packet = 0, .field = 0xa8, .reg = 0x3d7c },
+	{ .packet = 0, .field = 0xac, .reg = 0x3d80 },
+	{ .packet = 0, .field = 0xb0, .reg = 0x3d84 },
+	{ .packet = 1, .field = 0xe24, .reg = 0x8c },
+	{ .packet = 1, .field = 0x48, .reg = 0x3b70 },
+	{ .packet = 1, .field = 0xa4, .reg = 0x3d78 },
+	{ .packet = 1, .field = 0xa8, .reg = 0x3d7c },
+	{ .packet = 1, .field = 0xac, .reg = 0x3d80 },
+	{ .packet = 1, .field = 0xb0, .reg = 0x3d84 },
+	{ .packet = 2, .field = 0x8f4, .reg = 0x8c },
+	{ .packet = 2, .field = 0x48, .reg = 0x3b70 },
+	{ .packet = 2, .field = 0xa4, .reg = 0x3d78 },
+	{ .packet = 2, .field = 0xa8, .reg = 0x3d7c },
