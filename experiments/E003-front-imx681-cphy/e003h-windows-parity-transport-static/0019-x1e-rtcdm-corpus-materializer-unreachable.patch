+	{ .offset = 0xc00, .size = 0x374 }, /* 6 */
+	{ .offset = 0xf80, .size = 0x374 }, /* 7 */
+	{ .offset = 0x1300, .size = 0x374 }, /* 8 */
+	{ .offset = 0x1680, .size = 0x180 }, /* 9 */
+	{ .offset = 0x1800, .size = 0x374 }, /* 10 */
+	{ .offset = 0x1b80, .size = 0x1000 }, /* 11 */
+	{ .offset = 0x2b80, .size = 0x800 }, /* 12 */
