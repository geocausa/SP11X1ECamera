+int camss_x1e_pix_v4l2_start(struct camss_video *video, unsigned int count)
+{
+	struct camss_x1e_pix_runner_result result = { 0 };
+	struct camss_x1e_pix_runner_request req = { 0 };
+	struct camss_buffer *video0 = NULL, *video1 = NULL;
+	const struct firmware *fw = NULL;
+	struct media_pad *sensor_pad;
+	struct vfe_output *output;
+	struct v4l2_subdev *sensor;
+	struct vfe_device *vfe;
+	struct camss *camss;
+	unsigned long flags;
+	int ret;
+
+	if (!camss_x1e_pix_runtime_arm || !video || !video->camss || count != 2)
+		return -EPERM;
+	camss = video->camss;
+	if (!camss->res || camss->res->version != CAMSS_X1E80100 ||
+	    camss->res->vfe_num <= 1 ||
+	    video != &camss->vfe[1].line[VFE_LINE_PIX].video_out)
+		return -ENODEV;
+	if (atomic_cmpxchg(&camss_x1e_pix_gate_once, 0, 1))
+		return -EALREADY;
+
+	ret = request_firmware_direct(&fw, CAMSS_X1E_PIX_TRIGGER_FW, camss->dev);
+	if (ret)
+		return ret;
+	if (fw->size != CAMSS_X1E_PIX_GATE_CAPSULE_BYTES) {
+		ret = -EINVAL;
+		goto out_fw;
+	}
+
+	vfe = &camss->vfe[1];
+	output = &vfe->line[VFE_LINE_PIX].output;
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	video0 = vfe_buf_get_pending(output);
+	video1 = vfe_buf_get_pending(output);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	if (!video0 || !video1) {
+		ret = -ENOBUFS;
+		goto out_restore;
+	}
+	ret = camss_x1e_pix_v4l2_buffer(video, video0);
+	if (ret)
+		goto out_restore;
+	ret = camss_x1e_pix_v4l2_buffer(video, video1);
+	if (ret)
+		goto out_restore;
+
+	sensor_pad = media_pad_remote_pad_first(&camss->csiphy[2].pads[MSM_CSIPHY_PAD_SINK]);
+	if (!sensor_pad || !is_media_entity_v4l2_subdev(sensor_pad->entity)) {
+		ret = -ENOLINK;
+		goto out_restore;
+	}
+	sensor = media_entity_to_v4l2_subdev(sensor_pad->entity);
+	req.capsule = fw->data;
+	req.capsule_size = fw->size;
+	req.sensor = sensor;
+	req.video[0] = video0;
+	req.video[1] = video1;
+	ret = camss_x1e_pix_runner_validate(camss, &req);
+	if (ret)
+		goto out_restore;
+
+	ret = camss_x1e_pix_runner_once(camss, &req, &result);
+	if (!result.teardown_safe) {
+		video->x1e_pix_runner_pinned = true;
+		dev_err(camss->dev,
+			"E003h 0065 teardown unsafe; DMA ownership pinned until reboot\n");
+		if (!ret)
+			ret = -EIO;
+		video0 = NULL;
+		video1 = NULL;
+		goto out_fw;
+	}
+	if (ret || result.video_done != video0 || !result.epoch0_seen ||
+	    !result.video_seen) {
+		if (!ret)
+			ret = -EIO;
+		goto out_restore;
+	}
+
+	/* Hardware is already stopped by the bounded runner before vb2 completion. */
+	video0->vb.vb2_buf.timestamp = ktime_get_ns();
+	video0->vb.sequence = 0;
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	vfe_buf_add_pending(output, video1);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	video1 = NULL;
+	video->x1e_pix_runner_stopped = true;
+	vb2_buffer_done(&video0->vb.vb2_buf, VB2_BUF_STATE_DONE);
+	video0 = NULL;
+	dev_info(camss->dev,
+		 "E003h 0065 V4L2 QBUF/STREAMON completed one full VIDEO frame\n");
+	ret = 0;
+	goto out_fw;
+
+out_restore:
+	/* No producer is running after a teardown-safe runner return/failure. */
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (video0)
+		vfe_buf_add_pending(output, video0);
+	if (video1)
+		vfe_buf_add_pending(output, video1);
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+out_fw:
+	release_firmware(fw);
+	return ret;
+}
