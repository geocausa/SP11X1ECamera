+enum camss_rtcdm_diag_stage {
+	CAMSS_RTCDM_DIAG_IDLE,
+	CAMSS_RTCDM_DIAG_PREFLIGHT,
+	CAMSS_RTCDM_DIAG_RESET_WAIT,
+	CAMSS_RTCDM_DIAG_RESET_DONE,
+	CAMSS_RTCDM_DIAG_CORE_CONFIGURED,
+	CAMSS_RTCDM_DIAG_CORE_STARTED,
