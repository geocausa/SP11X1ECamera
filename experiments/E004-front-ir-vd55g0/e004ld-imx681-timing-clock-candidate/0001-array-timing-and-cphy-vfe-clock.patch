 /*
  * camss_get_pixel_clock - Get pixel clock rate from sensor
  * @entity: Media entity in the current pipeline
- * @pixel_clock: Received pixel clock value
+ * @bpp: Bits per sample at the VFE sink
+ * @pixel_clock: Received bus pixel clock value
  *
  * Return 0 on success or a negative error code otherwise
  */
-int camss_get_pixel_clock(struct media_entity *entity, u64 *pixel_clock)
+int camss_get_pixel_clock(struct media_entity *entity, unsigned int bpp,
+			  u64 *pixel_clock)
 {
 	struct media_pad *sensor_pad;
 	struct v4l2_subdev *subdev;
 	struct v4l2_ctrl *ctrl;
+	struct v4l2_mbus_config config = {};
+	unsigned int lanes;
+	u64 numerator, denominator;
+	int ret;

 	sensor_pad = camss_find_sensor_pad(entity);
 	if (!sensor_pad)
 		return -ENODEV;

 	subdev = media_entity_to_v4l2_subdev(sensor_pad->entity);
+
+	ret = v4l2_subdev_call(subdev, pad, get_mbus_config,
+			       sensor_pad->index, &config);
+	if (ret && ret != -ENOIOCTLCMD)
+		return ret;
+
+	/*
+	 * PIXEL_RATE describes the pixel array, not CSI transport throughput.
+	 * For an explicit C-PHY link use the bus rate documented in
+	 * Documentation/driver-api/media/tx-rx.rst. Keep legacy fallback for
+	 * sensors without this configuration and leave D-PHY unchanged.
+	 */
+	if (!ret && config.type == V4L2_MBUS_CSI2_CPHY &&
+	    config.link_freq) {
+		lanes = config.bus.mipi_csi2.num_data_lanes;
+		if (!lanes || lanes > 3 || !bpp || bpp > 64)
+			return -EINVAL;
+		if (config.link_freq > U64_MAX / (2 * lanes * 16))
+			return -ERANGE;
+		numerator = config.link_freq * 2 * lanes * 16;
+		denominator = 7 * bpp;
+		/* Round up without overflowing the numerator. */
+		*pixel_clock = div64_u64(numerator, denominator);
+		if (numerator % denominator)
+			(*pixel_clock)++;
+		return 0;
+	}

 	ctrl = v4l2_ctrl_find(subdev->ctrl_handler, V4L2_CID_PIXEL_RATE);

