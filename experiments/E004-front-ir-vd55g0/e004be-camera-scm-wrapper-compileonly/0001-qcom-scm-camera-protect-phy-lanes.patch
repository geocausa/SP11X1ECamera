+/*
+ * qcom_scm_camera_protect_phy_lanes() - protect/unprotect camera CSI PHY lanes
+ * @protect: true to protect lanes, false to release them
+ * @lane_mask: camera CP lane mask
+ *
+ * The SP11 Windows camera stack and historical Qualcomm camera Linux code use
+ * the 32-bit standard SIP encoding for CAMERASS service 0x18, command 0x07,
+ * even on ARM64.  Do not route this through qcom_scm_call(), whose negotiated
+ * convention can be SMC64: force the observed SMC32 ABI explicitly.
+ */
+int qcom_scm_camera_protect_phy_lanes(bool protect, u64 lane_mask)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_CAMERASS,
+		.cmd = QCOM_SCM_CAMERASS_PROTECT_PHY_LANES,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args[0] = protect,
+		.args[1] = lane_mask,
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res;
+	int ret;
+
+	ret = __scm_smc_call(__scm->dev, &desc, SMC_CONVENTION_ARM_32,
+			     &res, false);
+
+	return ret ? : res.result[0];
+}
+EXPORT_SYMBOL_GPL(qcom_scm_camera_protect_phy_lanes);
