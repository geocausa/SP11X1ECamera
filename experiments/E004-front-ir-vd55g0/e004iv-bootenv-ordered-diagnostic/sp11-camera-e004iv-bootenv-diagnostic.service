[Unit]
Description=SP11 E004iv one-shot GRUB-environment diagnostic (NO camera)
ConditionKernelCommandLine=sp11_camera_e004iv_bootenv_diagnostic=1
After=local-fs.target grub2-common.service grub-initrd-fallback.service
Wants=grub2-common.service grub-initrd-fallback.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=90
TimeoutStopSec=20
ExecStart=/usr/local/sbin/sp11-camera-e004iv-bootenv-diagnostic
ExecStopPost=/usr/bin/systemctl --no-block reboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
