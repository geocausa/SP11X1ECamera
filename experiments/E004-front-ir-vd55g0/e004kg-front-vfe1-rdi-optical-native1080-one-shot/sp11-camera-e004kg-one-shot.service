[Unit]
Description=SP11 E004kg front IMX681 CPHY-to-RDI RAW10 diagnostic to 1080p NV12 GStreamer; no rear or IR streaming; auto return Golden
Documentation=man:systemd.service(5)
ConditionKernelCommandLine=sp11_camera_e004kg_front_vfe1_rdi=1
After=local-fs.target systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
Wants=systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=420
TimeoutStopSec=20
ExecStart=/usr/local/sbin/sp11-camera-e004kg-run-once
# Runs on success, failure or timeout. One-shot GRUB next_entry is consumed
# before this unit starts and persistent saved_entry stays protected Golden.
ExecStopPost=/usr/bin/systemctl --no-block reboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
