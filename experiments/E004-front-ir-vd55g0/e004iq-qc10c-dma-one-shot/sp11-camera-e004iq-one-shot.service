[Unit]
Description=SP11 E004iq single QC10C DMA-guard regression and return to Golden
Documentation=man:systemd.service(5)
ConditionKernelCommandLine=sp11_camera_e004iq_qc10c_dma_guard=1
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=360
TimeoutStopSec=20
ExecStart=/usr/local/sbin/sp11-camera-e004iq-run-once
# Runs on success, failure or timeout. One-shot GRUB next_entry is consumed
# before this unit starts and persistent saved_entry stays protected Golden.
ExecStopPost=/usr/bin/systemctl --no-block reboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
