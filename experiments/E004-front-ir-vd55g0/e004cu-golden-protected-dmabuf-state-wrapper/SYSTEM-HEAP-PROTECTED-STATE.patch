+static int sp11_cpz_heap_check_quiescent(struct system_heap_buffer *buffer)
+{
+	if (buffer->mmap_cnt || buffer->vmap_cnt || buffer->cpu_access_cnt ||
+	    sp11_cpz_any_mapped_attachment(buffer))
+		return -EBUSY;
+	return 0;
+}
