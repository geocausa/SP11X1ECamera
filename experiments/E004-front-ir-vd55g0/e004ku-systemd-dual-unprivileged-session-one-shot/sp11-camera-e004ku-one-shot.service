[Unit]
Description=SP11 E004ku UID1000 dual-camera systemd sessions; no IR; auto return Golden
Documentation=man:systemd.service(5)
ConditionKernelCommandLine=sp11_camera_e004ku_rgb_session=1
After=local-fs.target systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
Wants=systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=300
TimeoutStopSec=20
ExecStart=/usr/local/sbin/sp11-camera-e004ku-run-once
# Runs on success, failure or timeout. One-shot GRUB next_entry is consumed
# before this unit starts and persistent saved_entry stays protected Golden.
ExecStopPost=/usr/bin/systemctl --no-block reboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
