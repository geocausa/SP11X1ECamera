[Unit]
Description=SP11 E004ls single-use root-sealed RGB native camera bounded sequential processed RGB viewfinder frame diagnostic; return Golden
ConditionKernelCommandLine=sp11_camera_e004ls_rgb_frames=1
After=local-fs.target systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
Wants=systemd-udev-settle.service grub2-common.service grub-initrd-fallback.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=150
TimeoutStopSec=15
ExecStart=/usr/local/sbin/sp11-camera-e004ls-run-once
ExecStopPost=/usr/bin/systemctl --no-block reboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
