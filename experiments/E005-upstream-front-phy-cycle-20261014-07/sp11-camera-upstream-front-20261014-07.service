[Unit]
Description=One-use upstream front26 sensor domain and final teardown probe
ConditionKernelCommandLine=sp11_camera_upstream_front_20261014_07=1
Wants=network-online.target grub-initrd-fallback.service grub2-common.service
After=network-online.target grub-initrd-fallback.service grub2-common.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -u /var/lib/sp11-camera-upstream-front-20261014-07/run-once.py
ExecStopPost=/var/lib/sp11-camera-upstream-front-20261014-07/return-golden.sh
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
