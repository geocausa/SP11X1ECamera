+/* SP11 Denali power sequencing, derived from the installed Windows CAMS resource. */
+static void ov13858_power_off(struct ov13858 *ov13858)
+{
+	if (!ov13858->powered)
+		return;
+
+	/* Windows D3: reset low, delay, MCLK off, rails off in reverse order. */
+	gpiod_set_value_cansleep(ov13858->reset, 1);
+	usleep_range(1000, 1500);
+	clk_disable_unprepare(ov13858->clk);
+	regulator_disable(ov13858->ldo16b);
+	regulator_disable(ov13858->ldo5m);
+	regulator_disable(ov13858->ldo1m);
+	regulator_disable(ov13858->ldo6m);
+	ov13858->powered = false;
+}
+
+static int ov13858_power_on(struct ov13858 *ov13858)
+{
+	struct device *dev = ov13858->dev;
+	int ret;
+
+	/* GPIO_ACTIVE_LOW: logical 1 is physical low/asserted reset. */
+	gpiod_set_value_cansleep(ov13858->reset, 1);
+
+	ret = regulator_enable(ov13858->ldo6m);
+	if (ret)
+		return dev_err_probe(dev, ret, "enable LDO6_M failed\n");
+
+	ret = regulator_enable(ov13858->ldo1m);
+	if (ret)
+		goto err_l6;
+
+	ret = regulator_enable(ov13858->ldo5m);
+	if (ret)
+		goto err_l1;
+
+	usleep_range(1000, 1500);
+
+	ret = regulator_enable(ov13858->ldo16b);
+	if (ret)
+		goto err_l5;
+
+	ret = clk_set_rate(ov13858->clk, OV13858_XCLK_FREQ);
+	if (ret)
+		goto err_l16;
+
+	if (clk_get_rate(ov13858->clk) != OV13858_XCLK_FREQ) {
+		ret = -EINVAL;
+		dev_err(dev, "MCLK1 rate is %lu, expected %lu\n",
+			clk_get_rate(ov13858->clk), OV13858_XCLK_FREQ);
+		goto err_l16;
+	}
+
+	ret = clk_prepare_enable(ov13858->clk);
+	if (ret)
+		goto err_l16;
+
+	gpiod_set_value_cansleep(ov13858->reset, 0);
+	usleep_range(10000, 12000);
+	ov13858->powered = true;
+	return 0;
+
+err_l16:
+	regulator_disable(ov13858->ldo16b);
+err_l5:
+	regulator_disable(ov13858->ldo5m);
+err_l1:
+	regulator_disable(ov13858->ldo1m);
+err_l6:
+	regulator_disable(ov13858->ldo6m);
+	return ret;
+}
+
+static int ov13858_runtime_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	return ov13858_power_on(to_ov13858(sd));
+}
+
+static int ov13858_runtime_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	ov13858_power_off(to_ov13858(sd));
+	return 0;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(ov13858_pm_ops,
+				 ov13858_runtime_suspend,
+				 ov13858_runtime_resume, NULL);
