+static int ov13858_select_mode_set_from_firmware(struct ov13858 *ov13858)
+{
+	struct v4l2_fwnode_endpoint vep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	bool surface_profile = false;
+	int ret;
+
+	/* Keep the upstream mode set for devices without a firmware endpoint. */
+	ov13858->modes = supported_modes;
+	ov13858->num_modes = ARRAY_SIZE(supported_modes);
+	ov13858->num_link_freqs = 2;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(ov13858->dev), NULL);
+	if (!ep)
+		goto selected;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &vep);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(ov13858->dev, ret,
+				     "failed to parse CSI endpoint\n");
+
+	/*
+	 * The Surface Pro 11 firmware profile is identified entirely by
+	 * standard CSI endpoint data: four D-PHY lanes and the board-proven
+	 * single 592.8 MHz link frequency.
+	 */
+	if (vep.bus.mipi_csi2.num_data_lanes == 4 &&
+	    vep.nr_of_link_frequencies == 1 &&
+	    vep.link_frequencies[0] == OV13858_LINK_FREQ_592_8MHZ)
+		surface_profile = true;
+
+	v4l2_fwnode_endpoint_free(&vep);
+
+	if (surface_profile) {
+		ov13858->modes = surface_pro11_modes;
+		ov13858->num_modes = ARRAY_SIZE(surface_pro11_modes);
+		ov13858->num_link_freqs = OV13858_NUM_OF_LINK_FREQS;
+		dev_info(ov13858->dev,
+			 "using four-lane 592.8 MHz firmware camera profile\n");
+	}
+
+selected:
+	ov13858->cur_mode = &ov13858->modes[0];
+	return 0;
+}
