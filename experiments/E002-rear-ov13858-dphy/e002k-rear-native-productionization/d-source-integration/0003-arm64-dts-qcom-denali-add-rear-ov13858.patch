+
+/* Rear RGB camera: Surface Pro 11 / Denali. */
+&apps_rsc {
+	pm8010_regulators: regulators-8 {
+		compatible = "qcom,pm8010-rpmh-regulators";
+		qcom,pmic-id = "m";
+		vdd-l1-l2-supply = <&vreg_s5j_1p2>;
+		vdd-l3-l4-supply = <&vreg_s4c_1p8>;
+		vdd-l5-supply = <&vreg_bob1>;
+		vdd-l6-supply = <&vreg_s4c_1p8>;
+		vdd-l7-supply = <&vreg_bob1>;
+
+		vreg_l1m_camera: ldo1 {
+			regulator-name = "vreg_l1m_camera";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1260000>;
+		};
+
+		vreg_l5m_camera: ldo5 {
+			regulator-name = "vreg_l5m_camera";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <3072000>;
+		};
+
+		vreg_l6m_camera: ldo6 {
+			regulator-name = "vreg_l6m_camera";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1808000>;
+		};
+	};
+};
+
+&camcc {
+	status = "okay";
+};
+
+&camss {
+	vdd-csiphy-0p8-supply = <&vreg_l2c_0p8>;
+	vdd-csiphy-1p2-supply = <&vreg_l1c_1p2>;
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			camss_csiphy1_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ov13858_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	pinctrl-0 = <&cci0_default>;
+	pinctrl-1 = <&cci0_sleep>;
+	pinctrl-names = "default", "sleep";
+	status = "okay";
+};
+
+&cci0_i2c1 {
+	clock-frequency = <400000>;
+
+	camera@10 {
+		compatible = "ovti,ov13858";
+		reg = <0x10>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		clock-names = "xclk";
+		reset-gpios = <&tlmm 110 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&rear_mclk1_default>;
+		pinctrl-names = "default";
+		dovdd-supply = <&vreg_l6m_camera>;
+		dvdd-supply = <&vreg_l1m_camera>;
+		avdd-supply = <&vreg_l5m_camera>;
+
+		port {
+			ov13858_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <592800000>;
+				remote-endpoint = <&camss_csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	cci0_default: cci0-default-state {
+		cci0-i2c1-pins {
+			pins = "gpio103", "gpio104";
+			function = "cci_i2c";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	cci0_sleep: cci0-sleep-state {
+		cci0-i2c1-pins {
+			pins = "gpio103", "gpio104";
+			function = "cci_i2c";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
+
+	rear_mclk1_default: rear-mclk1-default-state {
+		pins = "gpio97";
+		function = "cam_mclk";
+		drive-strength = <4>;
+		bias-disable;
+		output-enable;
+	};
+};
+
